orkspaces WHERE id = ?').run(workspaceId)\n\n      logAuditEvent({\n        action: 'workspace_deleted',\n        actor: auth.user.username,\n        actor_id: auth.user.id,\n        target_type: 'workspace',\n        target_id: workspaceId,\n        detail: {\n          name: existing.name,\n          slug: existing.slug,\n          agents_moved: (moved as any).changes,\n          moved_to_workspace: fallbackId,\n        },\n      })\n    })", "source_file": "/Users/amar/Desktop/MyCode/hermes/mission-control/src/app/api/workspaces/[id]/route.ts", "source_location": "L130"}, {"caller_nid": "route_delete", "callee": "transaction", "source_file": "/Users/amar/Desktop/MyCode/hermes/mission-control/src/app/api/workspaces/[id]/route.ts", "source_location": "L130"}, {"caller_nid": "route_delete", "callee": "json", "source_file": "/Users/amar/Desktop/MyCode/hermes/mission-control/src/app/api/workspaces/[id]/route.ts", "source_location": "L164"}, {"caller_nid": "route_delete", "callee": "error", "source_file": "/Users/amar/Desktop/MyCode/hermes/mission-control/src/app/api/workspaces/[id]/route.ts", "source_location": "L170"}, {"caller_nid": "route_delete", "callee": "json", "source_file": "/Users/amar/Desktop/MyCode/hermes/mission-control/src/app/api/workspaces/[id]/route.ts", "source_location": "L171"}]}